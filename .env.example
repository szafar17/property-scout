# ---------------------------------------------------------------------------
# Property Scout: environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Notion (config source + pipeline DB) ---
# Internal integration token: https://www.notion.so/my-integrations
NOTION_TOKEN=
# The config/runbook page id (the page holding the ```yaml config block).
NOTION_CONFIG_PAGE_ID=
# Pipeline data source id (Notion 2025-09 "data source" API).
NOTION_PIPELINE_DATA_SOURCE_ID=

# --- Anthropic (per-listing analysis in analyze.py) ---
ANTHROPIC_API_KEY=

# --- HCMLS via CoreLogic Trestle (RESO Web API / OData, OAuth2 client-creds) ---
# Provisioned at https://trestle.corelogic.com: request the Liberty Board / HCMLS feed.
TRESTLE_CLIENT_ID=
TRESTLE_CLIENT_SECRET=
TRESTLE_TOKEN_URL=https://api-trestle.corelogic.com/trestle/oidc/connect/token
TRESTLE_BASE_URL=https://api-trestle.corelogic.com/trestle/odata

# --- NJMLS via RE/Advantage IDX/data feed (Bergen/Passaic) ---
# Provisioned through your NJMLS IDX/data agreement with RE/Advantage.
# RE/Advantage may provision RETS or a RESO Web API; both paths are implemented and
# NJMLS_TRANSPORT=auto (the default) picks whichever is configured.
NJMLS_READVANTAGE_LOGIN_URL=
NJMLS_READVANTAGE_USERNAME=
NJMLS_READVANTAGE_PASSWORD=
NJMLS_READVANTAGE_USER_AGENT=property-scout/0.1
# If RE/Advantage issues a RETS UA password (RETS-UA-Authorization), set it here.
NJMLS_READVANTAGE_USER_AGENT_PASSWORD=
# RESO Web API path (only if RE/Advantage provisions OData instead of RETS).
NJMLS_RESO_BASE_URL=
NJMLS_RESO_CLIENT_ID=
NJMLS_RESO_CLIENT_SECRET=
NJMLS_RESO_TOKEN_URL=

# --- Enrichment ---
# Walk Score API: https://www.walkscore.com/professional/api.php
WALKSCORE_KEY=
# Google Maps Platform (Routes API + Geocoding fallback): https://console.cloud.google.com
GOOGLE_MAPS_KEY=
# Free api.data.gov key for FBI Crime Data Explorer (enrich/crime.py); FBI_CDE_KEY also works.
# Optional: absent -> municipal safety scores degrade to neutral.
DATA_GOV_KEY=

# --- Optional overrides (sensible defaults; leave blank unless needed) ---
# Force the NJMLS transport instead of auto-detecting: reso | rets | auto (default auto).
NJMLS_TRANSPORT=
# Override the NJ parcels (ArcGIS) base URL used by enrich/records.py.
NJ_PARCELS_URL=
# Where run.py writes the healthcheck file (default healthcheck.json).
PS_HEALTHCHECK=
